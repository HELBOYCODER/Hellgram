+    // helboy: pull latest commits of the community proxy repo and take 5 newest valid MTProto links
+    private void helboyFetchNewest() {
+        final Context ctx = getContext();
+        new Thread(() -> {
+            java.util.ArrayList<String> lines = new java.util.ArrayList<>();
+            String[] sources = {
+                "https://raw.githubusercontent.com/SoliSpirit/mtproto/master/all_proxies.txt"
+            };
+            try {
+                // newest-first commit shas; the source bot sometimes pushes an empty "update" commit
+                java.net.URL u = new java.net.URL("https://api.github.com/repos/SoliSpirit/mtproto/commits?per_page=5");
+                java.net.HttpURLConnection c = (java.net.HttpURLConnection) u.openConnection();
+                c.setConnectTimeout(8000); c.setReadTimeout(12000);
+                c.setRequestProperty("User-Agent", "Helboy/1.0");
+                String body = new String(c.getInputStream().readAllBytes(), "UTF-8");
+                java.util.regex.Matcher m = java.util.regex.Pattern.compile("\"sha\":\"([0-9a-f]{40})\"").matcher(body);
+                java.util.LinkedHashSet<String> shas = new java.util.LinkedHashSet<>();
+                while (m.find()) shas.add(m.group(1));
+                shas.add("master");
+                // stale-but-populated CDN cache as last resort
+                try {
+                    java.net.URL cu = new java.net.URL("https://cdn.jsdelivr.net/gh/SoliSpirit/mtproto@master/all_proxies.txt");
+                    java.net.HttpURLConnection cc = (java.net.HttpURLConnection) cu.openConnection();
+                    cc.setConnectTimeout(8000); cc.setReadTimeout(12000);
+                    cc.setRequestProperty("User-Agent", "Helboy/1.0");
+                    String cb = new String(cc.getInputStream().readAllBytes(), "UTF-8");
+                    java.net.URL ru = new java.net.URL("https://raw.githubusercontent.com/SoliSpirit/mtproto/master/all_proxies.txt");
+                    java.net.HttpURLConnection rc = (java.net.HttpURLConnection) ru.openConnection();
+                    rc.setConnectTimeout(8000); rc.setReadTimeout(12000);
+                    rc.setRequestProperty("User-Agent", "Helboy/1.0");
+                    String rb = new String(rc.getInputStream().readAllBytes(), "UTF-8");
+                    if (rb.split("\n").length < 3) {
+                        for (String l : cb.split("\n")) if (l.contains("/proxy?")) lines.add(l.trim());
+                    }
+                } catch (Throwable t) { }
+                for (String sha : shas) {
+                    try {
+                        java.net.URL fu = new java.net.URL("https://raw.githubusercontent.com/SoliSpirit/mtproto/" + sha + "/all_proxies.txt");
+                        java.net.HttpURLConnection fc = (java.net.HttpURLConnection) fu.openConnection();
+                        fc.setConnectTimeout(8000); fc.setReadTimeout(12000);
+                        fc.setRequestProperty("User-Agent", "Helboy/1.0");
+                        String[] arr = new String(fc.getInputStream().readAllBytes(), "UTF-8").split("\n");
+                        for (String l : arr) if (l.contains("/proxy?")) lines.add(l.trim());
+                        if (lines.size() >= 5) break;
+                    } catch (Throwable t) { }
+                }
+            } catch (Throwable t) { }
+            final java.util.ArrayList<String> result = new java.util.ArrayList<>();
+            java.util.HashSet<String> seen = new java.util.HashSet<>();
+            for (String l : lines) {
+                if (result.size() >= 5) break;
+                SharedConfig.ProxyInfo info = desu.inugram.helpers.network.HelboyProxyRefresher.parseProxy(l);
+                if (info == null) continue;
+                String key = info.settings.getAddress() + ":" + info.settings.getPort() + ":" + info.settings.getSecret();
+                if (!seen.add(key)) continue;
+                result.add(l);
+                final SharedConfig.ProxyInfo fi = info;
+                AndroidUtilities.runOnUIThread(() -> SharedConfig.addProxy(fi));
+            }
+            AndroidUtilities.runOnUIThread(() -> {
+                if (getParentActivity() == null) return;
+                listAdapter.notifyDataSetChanged();
+                org.telegram.ui.Components.BulletinFactory.of(ProxyListActivity.this).createSimpleBulletin(R.raw.info,
+                    result.isEmpty() ? getString(R.string.InuProxyFetchFailed)
+                                     : getString(R.string.InuProxyFetchDone).replace("%d", String.valueOf(result.size()))).show();
+            });
+        }, "helboy-fetch-newest").start();
+    }
 }
