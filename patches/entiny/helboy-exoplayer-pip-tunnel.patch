@@ -703,9 +703,15 @@ public class SettingsActivity extends BaseFragment implements NotificationCenter
 
         if (!desu.inugram.helpers.security.ParanoiaHelper.shouldHideSettings()) {
             items.add(SettingCell.Factory.of(99, IconBackgroundColors.ENTINY.top, IconBackgroundColors.ENTINY.bottom, R.drawable.icon_settings_inu, getString(R.string.InuSettings), getString(R.string.InuSettingsInfo)));
-            items.add(UItem.asShadow(null));
         }
 
+        // helboy: TV + tunnel surfaced next to the stock rows so they don't hide inside Hellgram settings
+        if (desu.inugram.InuConfig.HELBOY_TV.value) {
+            items.add(SettingCell.Factory.of(97, 0xFFE23A3A, 0xFF8B0000, R.drawable.inu_tabler_device_tv, getString(R.string.InuHelboyTv), getString(R.string.InuHelboyTvInfo)));
